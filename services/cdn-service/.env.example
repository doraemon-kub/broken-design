PORT=4001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/broken_design
JWT_SECRET=replace-with-strong-secret-key
WATERMARK_SECRET=replace-with-strong-watermark-secret
STORAGE_PROVIDER=supabase
STORAGE_DIR=./storage_data
TMP_UPLOAD_DIR=./tmp_uploads
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_STORAGE_BUCKET=models
MAX_MODEL_SIZE_BYTES=52428800
MAX_PREVIEW_SIZE_BYTES=5242880
MAX_POSTER_SIZE_BYTES=1048576
# CDN (/cdn) — set TRUST_PROXY=1 on Render so rate limits see the real client IP
TRUST_PROXY=0
CDN_PUBLIC_MAX_AGE=300
CDN_RATE_LIMIT_PER_MIN=600
CDN_KEY_FAILURES_PER_15MIN=30
CDN_DOWNLOADS_PER_MIN=30
